# ==============================================================================
# QualityTrack Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------
# SQLite (Local default):
DATABASE_URL="file:./dev.db"

# PostgreSQL (Render or production database):
# DATABASE_URL="postgresql://user:password@localhost:5432/qualitytrack?schema=public"

PORT=5000
JWT_SECRET="replace-with-a-secure-random-secret"
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Demo API Configuration (demo-api/.env)
# ------------------------------------------------------------------------------
PORT=5001
NODE_ENV="development"

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env)
# ------------------------------------------------------------------------------
# In development: leave empty to use Vite proxy (/api)
# In production on Render: set to your deployed backend URL:
# VITE_API_BASE_URL="https://qualitytrack-backend.onrender.com/api"
# VITE_DEMO_API_URL="https://qualitytrack-demo-api.onrender.com"
