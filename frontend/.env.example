# QualityTrack Frontend Environment Configuration

# Backend API Base URL
# In development: leave empty to use Vite's built-in proxy (/api -> localhost:5000)
# In production on Render: set to your deployed backend URL, e.g. https://qualitytrack-backend.onrender.com/api
VITE_API_BASE_URL="https://qualitytrack-backend.onrender.com/api"

# Simulated Demo API URL (Optional)
# In development: defaults to http://localhost:5001
# In production on Render: set to your deployed demo API URL, e.g. https://qualitytrack-demo-api.onrender.com
VITE_DEMO_API_URL="https://qualitytrack-demo-api.onrender.com"
