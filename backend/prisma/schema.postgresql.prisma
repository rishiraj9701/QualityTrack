// QualityTrack - PostgreSQL Production Schema
// To use PostgreSQL:
// 1. Set DATABASE_URL="postgresql://user:password@localhost:5432/qualitytrack?schema=public" in backend/.env
// 2. Copy this file over schema.prisma (or run: npm run db:use-postgres)
// 3. Run: npx prisma db push (or npx prisma migrate dev --name init)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  name         String
  passwordHash String
  role         String      @default("QA_ENGINEER")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  projects     Project[]

  @@map("users")
}

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  baseUrl     String?       @default("http://localhost:5001")
  currentEnv  String        @default("Development")
  userId      String?
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  environments Environment[]
  endpoints    APIEndpoint[]
  testSuites   TestSuite[]
  testCases    TestCase[]
  testRuns     TestRun[]
  bugReports   BugReport[]

  @@index([userId])
  @@map("projects")
}

model Environment {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  baseUrl     String
  variables   String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
  @@map("environments")
}

model APIEndpoint {
  id           String      @id @default(uuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  method       String
  path         String
  description  String?
  headers      String?
  bodyTemplate String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  testCases    TestCase[]
  bugReports   BugReport[]

  @@index([projectId])
  @@map("api_endpoints")
}

model TestSuite {
  id          String     @id @default(uuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  testCases   TestCase[]
  testRuns    TestRun[]

  @@index([projectId])
  @@map("test_suites")
}

model TestCase {
  id             String       @id @default(uuid())
  testCaseId     String
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suiteId        String?
  suite          TestSuite?   @relation(fields: [suiteId], references: [id], onDelete: SetNull)
  endpointId     String?
  endpoint       APIEndpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)
  name           String
  description    String?
  method         String
  path           String
  headers        String?
  queryParams    String?
  body           String?
  authType       String?      @default("none")
  authConfig     String?
  expectedStatus Int          @default(200)
  category       String
  priority       String       @default("Medium")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  assertions     Assertion[]
  testResults    TestResult[]
  bugReports     BugReport[]

  @@index([projectId])
  @@index([suiteId])
  @@index([endpointId])
  @@index([category])
  @@map("test_cases")
}

model Assertion {
  id            String   @id @default(uuid())
  testCaseId    String
  testCase      TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  type          String
  target        String?
  operator      String
  expectedValue String
  createdAt     DateTime @default(now())

  @@index([testCaseId])
  @@map("assertions")
}

model TestRun {
  id             String       @id @default(uuid())
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suiteId        String?
  suite          TestSuite?   @relation(fields: [suiteId], references: [id], onDelete: SetNull)
  executionType  String       @default("MANUAL")
  status         String       @default("PENDING")
  totalTests     Int          @default(0)
  passedTests    Int          @default(0)
  failedTests    Int          @default(0)
  skippedTests   Int          @default(0)
  durationMs     Int          @default(0)
  environment    String       @default("Development")
  triggeredBy    String       @default("Manual")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  testResults    TestResult[]

  @@index([projectId])
  @@index([suiteId])
  @@index([createdAt])
  @@map("test_runs")
}

model TestResult {
  id               String      @id @default(uuid())
  testRunId        String
  testRun          TestRun     @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCaseId       String
  testCase         TestCase    @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  status           String
  statusCode       Int?
  responseTimeMs   Int?
  responseSize     Int?
  responseHeaders  String?
  responseBody     String?
  errorMessage     String?
  assertionResults String?
  createdAt        DateTime    @default(now())

  bugReports       BugReport[]

  @@index([testRunId])
  @@index([testCaseId])
  @@map("test_results")
}

model BugReport {
  id               String       @id @default(uuid())
  bugId            String       @unique
  title            String
  description      String
  stepsToReproduce String
  expectedResult   String
  actualResult     String
  severity         String
  priority         String
  status           String       @default("Open")
  projectId        String
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  endpointId       String?
  endpoint         APIEndpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)
  testCaseId       String?
  testCase         TestCase?    @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  testResultId     String?
  testResult       TestResult?  @relation(fields: [testResultId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([projectId])
  @@index([endpointId])
  @@index([testCaseId])
  @@index([status])
  @@map("bug_reports")
}
